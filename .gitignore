# Awoki runtime workspace
# This entire tree is local user/project data. It can contain checked-out target
# repositories and their source code, notes, continuity memory, Burp evidence,
# reports, corpora, artifacts, indexes, and scratch files. Never commit it.
/workspace/

# Harness runtime state, legacy compatibility memory, and indexes
# Awoki source under .harness remains tracked; only mutable data is excluded.
/.harness/tmp/
/.harness/memory/
/.harness/notes.md
/.harness/index/*
!/.harness/index/README.md
/.harness/state/*
!/.harness/state/README.md

# Generated harness artifacts; retain only tracked directory documentation.
/.harness/artifacts/**/*
!/.harness/artifacts/**/
!/.harness/artifacts/**/README.md

# Awoki credential material if someone overrides the store into the repo
/secrets/
**/credentials/values/
**/credentials/exports/

# OpenCode-over-SSH container state
/.opencode-state/
/.ssh-container/
/.awoki-global/

# OS/editor
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# Generated structural code-search evaluation reports
/.harness/evaluation/code_search/reports/*.json
!/.harness/evaluation/code_search/reports/.gitkeep
