# Awoki runtime
AWOKI_PROJECT_ID=__auto__
AWOKI_MODE=docker
AWOKI_GLOBAL_ROOT=${HOME}/.awoki
AWOKI_GLOBAL_SKILLS_DIR=${HOME}/.config/opencode/skills

# Remote OpenAI-compatible embeddings. Qdrant remains Awoki's semantic store.
AWOKI_EMBEDDING_PROVIDER=openai
AWOKI_EMBEDDING_MODEL=text-embeddings-inference
# Stable operator-declared identity of the actual model served behind the API.
# Prefer an immutable model revision for full Qdrant backup compatibility checks.
AWOKI_EMBEDDING_DEPLOYMENT_ID=jinaai/jina-embeddings-v2-base-code
# Example remote OpenAI-compatible endpoint: http://embedding.example.invalid:8000/v1
AWOKI_EMBEDDING_BASE_URL=
AWOKI_EMBEDDING_API_KEY=
AWOKI_EMBEDDING_BATCH_SIZE=32
AWOKI_EMBEDDING_NORMALIZE=1
# Bulk indexing may wait longer; interactive semantic queries are deliberately
# short/no-retry so an unavailable endpoint cannot consume an MCP request.
AWOKI_EMBEDDING_TIMEOUT_SECONDS=30
AWOKI_EMBEDDING_MAX_RETRIES=1
# Detached vector-worker recovery after the provider/client retry budget is exhausted.
AWOKI_EMBEDDING_WORKER_MAX_RETRIES=2
AWOKI_EMBEDDING_RETRY_BACKOFF_SECONDS=1
AWOKI_EMBEDDING_ADAPTIVE_MIN_BATCH_SIZE=4
AWOKI_EMBEDDING_QUERY_TIMEOUT_SECONDS=5
AWOKI_EMBEDDING_QUERY_MAX_RETRIES=0
# jinaai/jina-embeddings-v2-base-code served by TEI returns 768 dimensions.
AWOKI_VECTOR_SIZE=768

# Optional remote HTTP reranker. When disabled or unavailable in fallback mode,
# Awoki keeps the existing fused FTS/Qdrant order.
AWOKI_RERANK_ENABLED=0
AWOKI_RERANK_PROVIDER=tei
AWOKI_RERANK_URL=
AWOKI_RERANK_MODEL=
AWOKI_RERANK_API_KEY=
# Advanced/local-process alternative: name an already-exported environment variable that contains the key.
# Stock Docker/OpenCode Compose cannot dynamically import an arbitrary variable by name; use
# AWOKI_RERANK_API_KEY there unless you explicitly add the named variable to the service environment.
# If this indirection is configured, Awoki validates it and will not issue an unauthenticated
# reranker request when the named variable is invalid, absent, or empty.
AWOKI_RERANK_API_KEY_ENV=
AWOKI_RERANK_TIMEOUT_SECONDS=20
AWOKI_RERANK_CANDIDATES=30
AWOKI_RERANK_TOP_N=10
AWOKI_RERANK_MAX_DOCUMENT_CHARS=4000
AWOKI_RERANK_FAIL_MODE=fallback

# Qdrant
AWOKI_QDRANT_HTTP_PORT=6333
AWOKI_QDRANT_GRPC_PORT=6334
AWOKI_QDRANT_HOST_URL=http://127.0.0.1:6333
QDRANT_URL=http://qdrant:6333
AWOKI_QDRANT_URL=http://qdrant:6333
AWOKI_QDRANT_CONTAINER_URL=http://qdrant:6333
AWOKI_QDRANT_COLLECTION=awoki_jina_embeddings_v2_base_code_768
# Dedicated structural-code vector collection. When empty, Awoki derives
# <AWOKI_QDRANT_COLLECTION>_code_v1.
AWOKI_CODE_QDRANT_COLLECTION=

# Bounded structural-code response budgets.
AWOKI_CODE_PEEK_MAX_CHARS=3000
AWOKI_CODE_CONTEXT_MAX_CHARS=16000
AWOKI_CODE_FULL_MAX_CHARS=50000
AWOKI_CODE_RRF_K=40
# Interactive repository search degradation budgets. These do not change bulk
# vector-indexing budgets.
AWOKI_CODE_QDRANT_TIMEOUT_SECONDS=2
# Optional code-search-specific reranker timeout override. Leave empty to inherit AWOKI_RERANK_TIMEOUT_SECONDS.
AWOKI_CODE_RERANK_TIMEOUT_SECONDS=
# Keep destructive recreation disabled; use a new collection name when models
# or vector dimensions change unless deletion is explicitly intended.
AWOKI_QDRANT_RECREATE_ON_DIM_MISMATCH=0

# Backward-compatible names; safe to remove after all callers use AWOKI_*.
HARNESS_PROJECT_ID=__auto__
HARNESS_MODE=docker
HARNESS_GLOBAL_ROOT=${HOME}/.awoki
HARNESS_GLOBAL_SKILLS_DIR=${HOME}/.config/opencode/skills
QDRANT_COLLECTION_PROJECT=awoki_project
QDRANT_COLLECTION_GLOBAL=awoki_global

# Burp integration. Burp MCP normally listens on the macOS host at 127.0.0.1:9876.
# The OpenCode container reaches it through Docker Desktop's host.docker.internal alias.
AWOKI_BURP_TARGET=local
AWOKI_BURP_HOST_URL=http://127.0.0.1:9876
AWOKI_BURP_CONTAINER_URL=http://host.docker.internal:9876
AWOKI_BURP_URL=http://host.docker.internal:9876
AWOKI_BURP_MCP_URL=http://host.docker.internal:9876
AWOKI_BURP_TIMEOUT=60
AWOKI_BURP_CALL_TIMEOUT=180

# Docker Compose project name and OpenCode-over-SSH settings. These are numeric
# Linux IDs for the container user, not host account/group synchronization.
# On macOS Docker Desktop the 1000:1000 defaults normally work.
AWOKI_COMPOSE_PROJECT_NAME=awoki
AWOKI_HOST_UID=1000
AWOKI_HOST_GID=1000
AWOKI_OPENCODE_SSH_PORT=2222

# Optional ad-hoc Lavish review served from the OpenCode SSH container and published only on host loopback.
AWOKI_LAVISH_PORT=4387
AWOKI_LAVISH_VERSION=0.1.43
