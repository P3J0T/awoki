#!/usr/bin/env bash
set -euo pipefail

ROOT="${AWOKI_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
CONFIG="${1:-$ROOT/.opencode-state/config/opencode.jsonc}"

if [[ ! -e "$CONFIG" ]]; then
  echo "awoki_opencode_user_config=absent path=$CONFIG"
  exit 0
fi
[[ -f "$CONFIG" ]] || {
  echo "[awoki] OpenCode user config exists but is not a regular file: $CONFIG" >&2
  exit 2
}
[[ ! -L "$CONFIG" ]] || {
  echo "[awoki] OpenCode user config must not be a symlink: $CONFIG" >&2
  exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
python3 - "$CONFIG" "$script_dir/.." <<'PY'
from pathlib import Path
import sys

sys.path.insert(0, sys.argv[2])
from jsonc import loads, validate_provider_config

path = Path(sys.argv[1])
try:
    validate_provider_config(loads(path.read_text(encoding="utf-8")))
except ValueError as exc:
    raise SystemExit(f"[awoki] invalid OpenCode user JSONC {path}: {exc}")
print(f"awoki_opencode_user_config=ok path={path}")
PY
