#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
import stat
import sys
import urllib.error
import urllib.request
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Authenticated OpenCode Web health probe")
    parser.add_argument("--url", required=True)
    parser.add_argument("--username", default="opencode")
    parser.add_argument("--password-file", required=True)
    parser.add_argument("--timeout", type=float, default=3.0)
    args = parser.parse_args()

    password_path = Path(args.password_file)
    if not password_path.is_file() or password_path.is_symlink():
        print(f"[awoki] invalid OpenCode Web password file: {password_path}", file=sys.stderr)
        return 2
    password_stat = password_path.stat()
    if stat.S_IMODE(password_stat.st_mode) != 0o600 or password_stat.st_nlink != 1:
        print("[awoki] OpenCode Web password file must be mode 0600 and not hard-linked", file=sys.stderr)
        return 2
    password = password_path.read_text(encoding="utf-8")
    if not password or "\n" in password or "\r" in password:
        print("[awoki] invalid OpenCode Web password content", file=sys.stderr)
        return 2

    token = base64.b64encode(f"{args.username}:{password}".encode()).decode("ascii")
    request = urllib.request.Request(
        args.url.rstrip("/") + "/global/health",
        headers={"Authorization": f"Basic {token}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            payload = json.load(response)
    except (OSError, urllib.error.URLError, ValueError, json.JSONDecodeError) as exc:
        print(f"[awoki] OpenCode Web health probe failed: {exc}", file=sys.stderr)
        return 1
    if payload.get("healthy") is not True or not isinstance(payload.get("version"), str):
        print(f"[awoki] OpenCode Web health response is invalid: {payload!r}", file=sys.stderr)
        return 1
    print(f"awoki_opencode_web=ok version={payload['version']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
