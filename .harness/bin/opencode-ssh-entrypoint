#!/usr/bin/env bash
set -euo pipefail

mkdir -p \
  /var/run/sshd \
  /home/op/.ssh \
  /home/op/.local/share/opencode \
  /home/op/.local/share/nvim \
  /home/op/.local/state/opencode \
  /home/op/.local/state/nvim \
  /home/op/.config/opencode \
  /home/op/.config/nvim \
  /home/op/.cache \
  /home/op/.npm \
  /global \
  /etc/awoki-ssh-host-keys
chmod 700 /home/op/.ssh

# OpenTUI extracts a native shared library to /tmp and maps executable segments
# from it. A Docker tmpfs mounted with the default noexec option produces:
# "failed to map segment from shared object". Fail early with a useful message
# instead of allowing OpenCode to crash after SSH login.
tmp_exec_probe="$(mktemp /tmp/.awoki-exec-probe.XXXXXX)"
if ! cp /bin/true "$tmp_exec_probe" \
  || ! chmod 700 "$tmp_exec_probe" \
  || ! "$tmp_exec_probe" >/dev/null 2>&1; then
  rm -f "$tmp_exec_probe"
  echo "[awoki] /tmp is not writable and executable; OpenTUI cannot load its native render library" >&2
  echo "[awoki] remove any noexec /tmp mount and recreate the OpenCode container" >&2
  exit 1
fi
rm -f "$tmp_exec_probe"

# Public-key login needs an unlocked account, but password authentication remains disabled.
passwd -d op >/dev/null 2>&1 || true
usermod -U op >/dev/null 2>&1 || true

if [[ ! -f /etc/awoki-ssh-host-keys/ssh_host_ed25519_key ]]; then
  ssh-keygen -q -t ed25519 -N "" -f /etc/awoki-ssh-host-keys/ssh_host_ed25519_key
fi
if [[ ! -f /etc/awoki-ssh-host-keys/ssh_host_rsa_key ]]; then
  ssh-keygen -q -t rsa -b 3072 -N "" -f /etc/awoki-ssh-host-keys/ssh_host_rsa_key
fi
chmod 600 /etc/awoki-ssh-host-keys/ssh_host_*_key
chmod 644 /etc/awoki-ssh-host-keys/ssh_host_*_key.pub

if [[ -z "${AWOKI_SSH_AUTHORIZED_KEY:-}" ]]; then
  echo "[awoki] missing AWOKI_SSH_AUTHORIZED_KEY; start the runtime through ./run-opencode.sh or make opencode-ssh-up" >&2
  exit 1
fi
if [[ "$AWOKI_SSH_AUTHORIZED_KEY" == *$'\n'* || "$AWOKI_SSH_AUTHORIZED_KEY" == *$'\r'* ]]; then
  echo "[awoki] AWOKI_SSH_AUTHORIZED_KEY must contain exactly one public-key line" >&2
  exit 1
fi
key_tmp="$(mktemp /tmp/.awoki-authorized-key.XXXXXX)"
printf '%s\n' "$AWOKI_SSH_AUTHORIZED_KEY" > "$key_tmp"
if ! ssh-keygen -lf "$key_tmp" >/dev/null 2>&1; then
  rm -f "$key_tmp"
  echo "[awoki] AWOKI_SSH_AUTHORIZED_KEY is not a valid SSH public key" >&2
  exit 1
fi
install -o op -g op -m 600 "$key_tmp" /home/op/.ssh/authorized_keys
rm -f "$key_tmp"
unset AWOKI_SSH_AUTHORIZED_KEY

cat >/etc/ssh/sshd_config.d/99-awoki-opencode.conf <<'EOF_CONFIG'
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no
StrictModes yes
AuthorizedKeysFile /home/op/.ssh/authorized_keys
HostKey /etc/awoki-ssh-host-keys/ssh_host_ed25519_key
HostKey /etc/awoki-ssh-host-keys/ssh_host_rsa_key
AllowUsers op
EOF_CONFIG

# Writable mounts are separate trust domains; source under /awoki stays root-owned.
for path in \
  /home/op \
  /global \
  /awoki/workspace \
  /awoki/.harness/state \
  /awoki/.harness/index \
  /awoki/.harness/artifacts \
  /awoki/.harness/memory \
  /awoki/.harness/tmp; do
  [[ -e "$path" ]] && chown -R op:op "$path" 2>/dev/null || true
done
[[ -e /awoki/.harness/notes.md ]] && chown op:op /awoki/.harness/notes.md 2>/dev/null || true

web_enabled=0
case "${AWOKI_OPENCODE_WEB_ENABLED:-1}" in
  1|true|TRUE|yes|YES|on|ON) web_enabled=1 ;;
  0|false|FALSE|no|NO|off|OFF) web_enabled=0 ;;
  *) echo "[awoki] invalid AWOKI_OPENCODE_WEB_ENABLED=${AWOKI_OPENCODE_WEB_ENABLED}" >&2; exit 2 ;;
esac
web_port="${AWOKI_OPENCODE_WEB_PORT:-4096}"
web_username="${AWOKI_OPENCODE_WEB_USERNAME:-opencode}"
if [[ ! "$web_port" =~ ^[0-9]+$ ]] || (( web_port < 1 || web_port > 65535 )); then
  echo "[awoki] invalid AWOKI_OPENCODE_WEB_PORT: $web_port" >&2
  exit 2
fi
if [[ ! "$web_username" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "[awoki] invalid AWOKI_OPENCODE_WEB_USERNAME: use letters, digits, dot, underscore, or dash" >&2
  exit 2
fi

web_runtime_password=/run/awoki/opencode-web-password
if (( web_enabled )); then
  web_host_password=/awoki-web-auth/password
  if [[ ! -f "$web_host_password" || -L "$web_host_password" ]]; then
    echo "[awoki] OpenCode Web is enabled but the host password file is missing or unsafe: $web_host_password" >&2
    echo "[awoki] start through ./run-opencode.sh so the host-side 0600 secret is prepared" >&2
    exit 1
  fi
  install -d -o root -g "$(id -g op)" -m 0750 /run/awoki
  install -o op -g op -m 0600 "$web_host_password" "$web_runtime_password"
  python3 - "$web_runtime_password" <<'PY_WEB_SECRET'
from pathlib import Path
import sys
value = Path(sys.argv[1]).read_text(encoding="utf-8")
if not value or "\n" in value or "\r" in value:
    raise SystemExit("[awoki] OpenCode Web password must be a non-empty single line")
PY_WEB_SECRET

  # OpenCode Web currently attempts to invoke xdg-open. Keep that convenience
  # process-local and harmless in the headless container instead of installing a
  # desktop/browser stack or globally shadowing xdg-open.
  install -d -o root -g root -m 0755 /run/awoki/opencode-web-bin
  cat >/run/awoki/opencode-web-bin/xdg-open <<'EOF_XDG'
#!/bin/sh
exit 0
EOF_XDG
  chmod 0755 /run/awoki/opencode-web-bin/xdg-open
fi

# Refresh the allowlisted runtime snapshot used by clean SSH/MCP shells. The
# OpenCode Web password is deliberately not part of this snapshot.
/awoki/.harness/bin/awoki-runtime-snapshot >/dev/null

# Validate runtime surfaces that otherwise fail only after SSH login: the resolved
# OpenCode CLI/plugin/SDK tuple, the Python MCP SDK/entrypoint, and tmux config.
if ! runuser -u op -- env -i HOME=/home/op USER=op LOGNAME=op \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  AWOKI_ROOT=/awoki \
  /awoki/.harness/bin/opencode-runtime-compat-check >/dev/null; then
  echo "[awoki] OpenCode runtime compatibility check failed; rebuild in latest mode or select a known-good safe version" >&2
  exit 1
fi
if ! runuser -u op -- env -i \
  HOME=/home/op USER=op LOGNAME=op \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 LC_ALL=C.UTF-8 \
  AWOKI_ROOT=/awoki \
  HARNESS_ROOT=/awoki \
  AWOKI_GLOBAL_ROOT=/global \
  HARNESS_GLOBAL_ROOT=/global \
  PYTHONPATH=/awoki/.harness:/awoki \
  /awoki/.harness/bin/mcp-preflight --quiet; then
  echo "[awoki] Awoki MCP preflight failed; rebuild the image and inspect /awoki/.harness/state/mcp-local.stderr.log" >&2
  exit 1
fi
if ! runuser -u op -- env -i HOME=/home/op USER=op LOGNAME=op \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  TERM="${TERM:-xterm-256color}" LANG=C.UTF-8 LC_ALL=C.UTF-8 \
  /awoki/.harness/bin/tmux-check >/dev/null; then
  echo "[awoki] tmux configuration validation failed; inspect /home/op/.tmux.conf.local" >&2
  exit 1
fi

if (( ! web_enabled )); then
  exec /usr/sbin/sshd -D -e
fi

# Start the Web backend with a clean environment, but do not place the password
# in runuser/env argv. The op-owned child reads the 0600 tmpfs file itself and
# exports the plaintext only in its own environment because OpenCode Basic Auth
# requires the original secret.
runuser -u op -- env -i \
  HOME=/home/op USER=op LOGNAME=op \
  PATH=/run/awoki/opencode-web-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  TERM="${TERM:-xterm-256color}" LANG=C.UTF-8 LC_ALL=C.UTF-8 \
  AWOKI_ROOT=/awoki AWOKI_MODE=container-opencode HARNESS_ROOT=/awoki HARNESS_MODE=container-opencode \
  OPENCODE_CONFIG_DIR=/awoki/.opencode OPENCODE_DISABLE_AUTOUPDATE=1 \
  AWOKI_OPENCODE_WEB_PORT="$web_port" AWOKI_OPENCODE_WEB_USERNAME="$web_username" \
  AWOKI_OPENCODE_WEB_RUNTIME_PASSWORD_FILE="$web_runtime_password" \
  /bin/bash -c '
    set -euo pipefail
    password_file="${AWOKI_OPENCODE_WEB_RUNTIME_PASSWORD_FILE:?}"
    [[ -f "$password_file" && ! -L "$password_file" ]] || exit 2
    OPENCODE_SERVER_PASSWORD="$(cat "$password_file")"
    export OPENCODE_SERVER_PASSWORD
    export OPENCODE_SERVER_USERNAME="$AWOKI_OPENCODE_WEB_USERNAME"
    exec opencode web --hostname 0.0.0.0 --port "$AWOKI_OPENCODE_WEB_PORT"
  ' &
web_pid=$!

web_ready=0
for _ in $(seq 1 30); do
  if ! kill -0 "$web_pid" 2>/dev/null; then
    wait "$web_pid" || true
    echo "[awoki] OpenCode Web exited before becoming healthy" >&2
    exit 1
  fi
  if /awoki/.harness/bin/opencode-web-health \
      --url "http://127.0.0.1:${web_port}" \
      --username "$web_username" \
      --password-file "$web_runtime_password" \
      --timeout 1 >/dev/null 2>&1; then
    web_ready=1
    break
  fi
  sleep 1
done
if (( ! web_ready )); then
  kill "$web_pid" 2>/dev/null || true
  wait "$web_pid" 2>/dev/null || true
  echo "[awoki] OpenCode Web did not become healthy on 127.0.0.1:${web_port}" >&2
  exit 1
fi

/usr/sbin/sshd -D -e &
sshd_pid=$!
cleanup() {
  trap - EXIT INT TERM
  kill "$sshd_pid" "$web_pid" 2>/dev/null || true
  wait "$sshd_pid" 2>/dev/null || true
  wait "$web_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
set +e
wait -n "$sshd_pid" "$web_pid"
status=$?
set -e
cleanup
exit "$status"
