#!/usr/bin/env bash
set -euo pipefail
ROOT="${AWOKI_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PASSWORD_FILE="${AWOKI_OPENCODE_WEB_PASSWORD_FILE:-$ROOT/.opencode-state/web-auth/password}"

[[ -f "$PASSWORD_FILE" && ! -L "$PASSWORD_FILE" ]] || {
  echo "[awoki] OpenCode Web password is not initialized; run ./run-opencode.sh first" >&2
  exit 2
}
python3 - "$PASSWORD_FILE" <<'PY'
from pathlib import Path
import os
import stat
import sys
path = Path(sys.argv[1])
st = path.stat()
if st.st_uid != os.getuid():
    raise SystemExit(f"[awoki] refusing to print OpenCode Web password not owned by the current user: {path}")
if st.st_nlink != 1:
    raise SystemExit(f"[awoki] refusing to print hard-linked OpenCode Web password file: {path}")
if stat.S_IMODE(st.st_mode) != 0o600:
    raise SystemExit(f"[awoki] refusing to print OpenCode Web password with mode {stat.S_IMODE(st.st_mode):04o}; expected 0600")
value = path.read_text(encoding="utf-8")
if not value or "\n" in value or "\r" in value:
    raise SystemExit("[awoki] invalid OpenCode Web password file")
print(value)
PY
