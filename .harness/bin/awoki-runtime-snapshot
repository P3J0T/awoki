#!/usr/bin/env bash
set -euo pipefail

runtime_env_dir="${AWOKI_RUNTIME_ENV_DIR:-/run/awoki}"
runtime_env_file="${AWOKI_RUNTIME_ENV_FILE:-$runtime_env_dir/runtime.env}"

if [[ "$(id -u)" != "0" ]]; then
  echo "[awoki] runtime snapshot refresh must run as root" >&2
  exit 1
fi
if ! id -u op >/dev/null 2>&1; then
  echo "[awoki] runtime snapshot refresh requires the op account" >&2
  exit 1
fi

if [[ -z "${AWOKI_RERANK_API_KEY:-}" && -n "${AWOKI_RERANK_API_KEY_ENV:-}" ]]; then
  rerank_key_env="${AWOKI_RERANK_API_KEY_ENV}"
  if [[ ! "$rerank_key_env" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "[awoki] invalid AWOKI_RERANK_API_KEY_ENV variable name: $rerank_key_env" >&2
    exit 1
  fi
  if declare -p "$rerank_key_env" >/dev/null 2>&1 && [[ -n "${!rerank_key_env}" ]]; then
    export AWOKI_RERANK_API_KEY="${!rerank_key_env}"
  else
    case "${AWOKI_RERANK_ENABLED:-0}" in
      1|true|TRUE|yes|YES|on|ON)
        echo "[awoki] AWOKI_RERANK_API_KEY_ENV names '$rerank_key_env', but that variable is absent or empty" >&2
        exit 1
        ;;
    esac
  fi
fi

runtime_env_gid="$(id -g op)"
runtime_env_names=(
  AWOKI_ROOT AWOKI_MODE AWOKI_PROJECT_ID AWOKI_GLOBAL_ROOT AWOKI_GLOBAL_SKILLS_DIR
  AWOKI_QDRANT_URL AWOKI_QDRANT_HOST_URL AWOKI_QDRANT_CONTAINER_URL
  AWOKI_QDRANT_COLLECTION AWOKI_QDRANT_RECREATE_ON_DIM_MISMATCH AWOKI_CODE_QDRANT_COLLECTION
  AWOKI_CODE_PEEK_MAX_CHARS AWOKI_CODE_CONTEXT_MAX_CHARS AWOKI_CODE_FULL_MAX_CHARS
  AWOKI_CODE_RRF_K AWOKI_CODE_QDRANT_TIMEOUT_SECONDS AWOKI_CODE_RERANK_TIMEOUT_SECONDS
  QDRANT_URL QDRANT_COLLECTION_PROJECT QDRANT_COLLECTION_GLOBAL
  AWOKI_EMBEDDING_PROVIDER AWOKI_EMBEDDING_MODEL AWOKI_EMBEDDING_DEPLOYMENT_ID
  AWOKI_EMBEDDING_BASE_URL AWOKI_EMBEDDING_API_KEY AWOKI_EMBEDDING_BATCH_SIZE
  AWOKI_EMBEDDING_NORMALIZE AWOKI_EMBEDDING_TIMEOUT_SECONDS AWOKI_EMBEDDING_MAX_RETRIES
  AWOKI_EMBEDDING_QUERY_TIMEOUT_SECONDS AWOKI_EMBEDDING_QUERY_MAX_RETRIES
  AWOKI_EMBEDDING_WORKER_MAX_RETRIES AWOKI_EMBEDDING_RETRY_BACKOFF_SECONDS
  AWOKI_EMBEDDING_ADAPTIVE_MIN_BATCH_SIZE AWOKI_VECTOR_SIZE AWOKI_QUERY_PREFIX
  AWOKI_DOCUMENT_PREFIX AWOKI_ALLOW_HASH_EMBEDDINGS
  AWOKI_RERANK_ENABLED AWOKI_RERANK_PROVIDER AWOKI_RERANK_URL AWOKI_RERANK_MODEL
  AWOKI_RERANK_API_KEY AWOKI_RERANK_API_KEY_ENV AWOKI_RERANK_TIMEOUT_SECONDS
  AWOKI_RERANK_CANDIDATES AWOKI_RERANK_TOP_N AWOKI_RERANK_MAX_DOCUMENT_CHARS
  AWOKI_RERANK_FAIL_MODE
  AWOKI_BURP_TARGET AWOKI_BURP_HOST_URL AWOKI_BURP_CONTAINER_URL AWOKI_BURP_URL
  AWOKI_BURP_MCP_URL AWOKI_BURP_TIMEOUT AWOKI_BURP_CALL_TIMEOUT
  AWOKI_OPENCODE_WEB_ENABLED AWOKI_OPENCODE_WEB_PORT AWOKI_OPENCODE_WEB_USERNAME
  AWOKI_LAVISH_PORT AWOKI_LAVISH_VERSION LAVISH_AXI_PORT LAVISH_AXI_HOST
  LAVISH_AXI_LINK_HOST LAVISH_AXI_ALLOWED_HOSTS LAVISH_AXI_NO_OPEN LAVISH_AXI_STATE_DIR
  HARNESS_ROOT HARNESS_MODE HARNESS_PROJECT_ID HARNESS_GLOBAL_ROOT HARNESS_GLOBAL_SKILLS_DIR
)

install -d -o root -g "$runtime_env_gid" -m 0750 "$runtime_env_dir"
(
  set -euo pipefail
  umask 077
  runtime_env_tmp="$(mktemp "$runtime_env_dir/.runtime.env.XXXXXX")"
  trap 'rm -f "$runtime_env_tmp"' EXIT
  {
    printf '# Generated by awoki-runtime-snapshot; do not edit.\n'
    for runtime_env_name in "${runtime_env_names[@]}"; do
      if declare -p "$runtime_env_name" >/dev/null 2>&1; then
        printf 'export %s=%q\n' "$runtime_env_name" "${!runtime_env_name}"
      fi
    done
  } >"$runtime_env_tmp"
  chown "root:$runtime_env_gid" "$runtime_env_tmp"
  chmod 0640 "$runtime_env_tmp"
  mv -f "$runtime_env_tmp" "$runtime_env_file"
  trap - EXIT
)

if ! runuser -u op -- env -i HOME=/home/op /bin/bash -c '
  set -euo pipefail
  f="$1"
  [[ -r "$f" && ! -L "$f" ]]
  source "$f"
  [[ "${AWOKI_ROOT:-}" == "/awoki" ]]
  [[ "${AWOKI_MODE:-}" == "container-opencode" ]]
  [[ "${AWOKI_QDRANT_URL:-}" == "http://qdrant:6333" ]]
' _ "$runtime_env_file"; then
  echo "[awoki] runtime environment handoff validation failed" >&2
  exit 1
fi

printf '[awoki] runtime environment snapshot refreshed: %s\n' "$runtime_env_file" >&2
