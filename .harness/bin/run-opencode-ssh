#!/usr/bin/env bash
set -euo pipefail

ROOT="${AWOKI_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$ROOT"

"$ROOT/.harness/bin/awoki-backup" lock-check >/dev/null

SSH_DIR="$ROOT/.ssh-container"
STATE="$ROOT/.opencode-state"
INIT_MARKER="$ROOT/.harness/state/layout_initialized.json"
COMPOSE_FILE="$ROOT/docker-compose.opencode.yml"

read_env_default() {
  local key="$1"
  local default_value="$2"
  local value=""
  if [[ -f "$ROOT/.env" ]]; then
    value="$(awk -F= -v k="$key" '
      $0 ~ /^[[:space:]]*#/ { next }
      $0 !~ /=/ { next }
      {
        key=$1
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        if (key == k) {
          sub(/^[^=]*=/, "")
          gsub(/^[[:space:]]+|[[:space:]]+$/, "")
          gsub(/^"|"$/, "")
          print
        }
      }
    ' "$ROOT/.env" | tail -n 1)"
  fi
  printf '%s' "${value:-$default_value}"
}

SSH_PORT="${AWOKI_OPENCODE_SSH_PORT:-$(read_env_default AWOKI_OPENCODE_SSH_PORT 2222)}"
WEB_ENABLED_RAW="${AWOKI_OPENCODE_WEB_ENABLED:-$(read_env_default AWOKI_OPENCODE_WEB_ENABLED 1)}"
WEB_PORT="${AWOKI_OPENCODE_WEB_PORT:-$(read_env_default AWOKI_OPENCODE_WEB_PORT 4096)}"
WEB_USERNAME="${AWOKI_OPENCODE_WEB_USERNAME:-$(read_env_default AWOKI_OPENCODE_WEB_USERNAME opencode)}"
WEB_PASSWORD_OVERRIDE="${AWOKI_OPENCODE_WEB_PASSWORD:-$(read_env_default AWOKI_OPENCODE_WEB_PASSWORD '')}"
COMPOSE_PROJECT_NAME="${AWOKI_COMPOSE_PROJECT_NAME:-$(read_env_default AWOKI_COMPOSE_PROJECT_NAME awoki)}"

case "$WEB_ENABLED_RAW" in
  1|true|TRUE|yes|YES|on|ON) WEB_ENABLED=1 ;;
  0|false|FALSE|no|NO|off|OFF) WEB_ENABLED=0 ;;
  *) echo "[awoki] invalid AWOKI_OPENCODE_WEB_ENABLED: $WEB_ENABLED_RAW" >&2; exit 2 ;;
esac

export AWOKI_OPENCODE_SSH_PORT="$SSH_PORT"
export AWOKI_OPENCODE_WEB_ENABLED="$WEB_ENABLED"
export AWOKI_OPENCODE_WEB_PORT="$WEB_PORT"
export AWOKI_OPENCODE_WEB_USERNAME="$WEB_USERNAME"
export AWOKI_COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME"

if [[ ! "$SSH_PORT" =~ ^[0-9]+$ ]] || (( SSH_PORT < 1 || SSH_PORT > 65535 )); then
  echo "[awoki] invalid AWOKI_OPENCODE_SSH_PORT: $SSH_PORT" >&2
  exit 2
fi
if [[ ! "$WEB_PORT" =~ ^[0-9]+$ ]] || (( WEB_PORT < 1 || WEB_PORT > 65535 )); then
  echo "[awoki] invalid AWOKI_OPENCODE_WEB_PORT: $WEB_PORT" >&2
  exit 2
fi
if [[ "$WEB_PORT" == "$SSH_PORT" ]]; then
  echo "[awoki] AWOKI_OPENCODE_WEB_PORT must differ from AWOKI_OPENCODE_SSH_PORT" >&2
  exit 2
fi
if [[ ! "$WEB_USERNAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "[awoki] invalid AWOKI_OPENCODE_WEB_USERNAME: use letters, digits, dot, underscore, or dash" >&2
  exit 2
fi

if [[ ! -f "$INIT_MARKER" ]]; then
  echo "Awoki base layout is not initialized." >&2
  echo "Run this once from the repo root first:" >&2
  echo "  ./init-awoki.sh" >&2
  exit 2
fi
if [[ -L "$INIT_MARKER" ]]; then
  echo "[awoki] layout marker must not be a symlink: $INIT_MARKER" >&2
  exit 2
fi
read_runtime_instance_id() {
  python3 - "$INIT_MARKER" <<'PY_RUNTIME_ID'
import json
import re
import sys
from pathlib import Path

try:
    value = str(json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("runtime_instance_id", ""))
except Exception as exc:
    raise SystemExit(f"[awoki] invalid layout marker: {exc}")
if value and not re.fullmatch(r"[0-9a-f]{32}", value):
    raise SystemExit("[awoki] layout marker contains an invalid runtime_instance_id")
print(value)
PY_RUNTIME_ID
}
AWOKI_RUNTIME_INSTANCE_ID="$(read_runtime_instance_id)"
if [[ -z "$AWOKI_RUNTIME_INSTANCE_ID" ]]; then
  echo "[awoki] upgrading legacy layout marker with a runtime-instance identity." >&2
  "$ROOT/.harness/bin/init-layout" >/dev/null
  AWOKI_RUNTIME_INSTANCE_ID="$(read_runtime_instance_id)"
fi
[[ "$AWOKI_RUNTIME_INSTANCE_ID" =~ ^[0-9a-f]{32}$ ]] || {
  echo "[awoki] failed to initialize runtime-instance identity; rerun ./init-awoki.sh" >&2
  exit 2
}
export AWOKI_RUNTIME_INSTANCE_ID

for required in "$ROOT/workspace" "$ROOT/workspace/projects" "$ROOT/.harness/index" "$ROOT/.harness/artifacts" "$ROOT/.awoki-global" "$ROOT/data/qdrant" "$ROOT/data/qdrant/collections"; do
  if [[ ! -d "$required" ]]; then
    echo "Awoki layout is incomplete: missing $required" >&2
    echo "Repair it with:" >&2
    echo "  ./init-awoki.sh" >&2
    exit 2
  fi
done

mkdir -p "$STATE/share" "$STATE/local-state" "$STATE/config" "$STATE/cache" "$STATE/npm" "$ROOT/.harness/memory" "$ROOT/.harness/tmp"

if (( WEB_ENABLED )); then
  AWOKI_OPENCODE_WEB_PASSWORD="$WEB_PASSWORD_OVERRIDE" \
    "$ROOT/.harness/bin/prepare-opencode-web-auth" >/dev/null
fi
unset AWOKI_OPENCODE_WEB_PASSWORD WEB_PASSWORD_OVERRIDE

# Prepare and validate the host key pair, then pass only the public key through
# Compose environment. Docker Desktop can fail individual host-file binds even
# when the containing directory is shared correctly; no SSH key file is mounted.
AWOKI_SSH_AUTHORIZED_KEY="$("$ROOT/.harness/bin/opencode-ssh-public-key")"
export AWOKI_SSH_AUTHORIZED_KEY

# A checkout can be deleted/recreated at the same macOS pathname while Docker
# Desktop still holds bind mounts to the old directory object. Reconcile those
# clearly stale same-path containers before any bind-mount probe. Different-path
# project collisions fail closed and are never removed automatically.
"$ROOT/.harness/bin/reconcile-opencode-runtime" "$COMPOSE_FILE"

# Qdrant uses a host bind for durable storage. Materialize and write-probe the
# collections parent from Docker's own mount view before starting the service so
# filesystem/share problems fail here instead of after a long vector build.
"$ROOT/.harness/bin/prepare-qdrant-storage" "$COMPOSE_FILE"

check_published_port() {
  local label="$1" port="$2" service="$3" disposition
  disposition="$(
    "$ROOT/.harness/bin/reconcile-opencode-port-owner" \
      "$COMPOSE_FILE" "$port" "$label" "$service"
  )"
  case "$disposition" in
    free|recovered|current) return 0 ;;
    *)
      echo "[awoki] unexpected ${label} port-owner disposition: $disposition" >&2
      exit 3
      ;;
  esac
}

check_published_port "SSH" "$SSH_PORT" awoki-opencode-ssh
check_published_port "OpenCode Web" "$WEB_PORT" awoki-opencode-ssh

# Start Qdrant alone first. The actual long-lived service container, not merely
# a disposable Compose probe, owns the storage contract.
docker compose -f "$COMPOSE_FILE" up -d qdrant
AWOKI_QDRANT_WAIT_COMPOSE_FILE="$COMPOSE_FILE" \
AWOKI_QDRANT_WAIT_SERVICE=awoki-opencode-ssh \
  "$ROOT/.harness/bin/wait-qdrant"

# Verify the exact running Qdrant container after Compose has reconciled it.
AWOKI_QDRANT_STORAGE_LIVE_ONLY=1 \
  "$ROOT/.harness/bin/prepare-qdrant-storage" "$COMPOSE_FILE"

opencode_up=(docker compose -f "$COMPOSE_FILE" up -d)
case "${AWOKI_OPENCODE_FORCE_RECREATE:-0}" in
  1|true|yes|on) opencode_up+=(--force-recreate) ;;
esac
opencode_up+=(awoki-opencode-ssh)
"${opencode_up[@]}"

CONTAINER_NAME="$(docker compose -f "$COMPOSE_FILE" ps -q awoki-opencode-ssh)"

wait_for_ssh() {
  local deadline=$((SECONDS + 30))
  while (( SECONDS < deadline )); do
    if [[ -n "$CONTAINER_NAME" ]]; then
      local state
      state="$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
      if [[ "$state" == "exited" || "$state" == "dead" || "$state" == "restarting" ]]; then
        echo "[awoki] OpenCode SSH container is $state; recent logs:" >&2
        docker logs "$CONTAINER_NAME" --tail=80 >&2 || true
        return 1
      fi
    fi

    if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 "$SSH_PORT" >/dev/null 2>&1; then
      return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
      if python3 - "$SSH_PORT" >/dev/null 2>&1 <<'PY'
import socket
import sys

port = int(sys.argv[1])
s = socket.socket()
s.settimeout(0.5)
s.connect(("127.0.0.1", port))
s.close()
PY
      then
        return 0
      fi
    fi

    sleep 1
  done

  echo "[awoki] SSH did not become ready on 127.0.0.1:$SSH_PORT within 30s." >&2
  if [[ -n "$CONTAINER_NAME" ]]; then
    docker logs "$CONTAINER_NAME" --tail=80 >&2 || true
  fi
  return 1
}

wait_for_ssh

wait_for_web() {
  (( WEB_ENABLED )) || return 0
  local deadline=$((SECONDS + 30))
  local password_file="$STATE/web-auth/password"
  while (( SECONDS < deadline )); do
    if "$ROOT/.harness/bin/opencode-web-health" \
      --url "http://127.0.0.1:${WEB_PORT}" \
      --username "$WEB_USERNAME" \
      --password-file "$password_file" \
      --timeout 1 >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "[awoki] OpenCode Web did not become healthy on http://127.0.0.1:${WEB_PORT}" >&2
  [[ -n "$CONTAINER_NAME" ]] && docker logs "$CONTAINER_NAME" --tail=100 >&2 || true
  return 1
}

wait_for_web

echo
echo "[awoki] verifying host SSH key material, container authorization, and real public-key login..."
"$ROOT/.harness/bin/verify-opencode-ssh-client"

if (( WEB_ENABLED )); then
  echo "OpenCode Web: http://127.0.0.1:${WEB_PORT}"
  echo "OpenCode Web username: ${WEB_USERNAME}"
  echo "Show the generated password explicitly with:"
  echo "  make opencode-web-password"
  echo
fi
echo "SSH into OpenCode container with:"
echo "ssh -i $SSH_DIR/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=$SSH_DIR/known_hosts -o StrictHostKeyChecking=accept-new -p $SSH_PORT op@127.0.0.1"
echo
echo "Then run the Awoki client wrapper (attaches to the shared Web backend when enabled):"
echo "cd /awoki && awoki-opencode"
