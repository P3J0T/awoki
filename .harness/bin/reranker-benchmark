#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import time
from typing import Any
import http.client
from urllib.parse import urlsplit, urlunsplit


def _positive_int(value: str) -> int:
    parsed = int(value)
    if parsed < 2 or parsed > 100:
        raise argparse.ArgumentTypeError("must be between 2 and 100")
    return parsed


def _positive_float(value: str) -> float:
    parsed = float(value)
    if parsed <= 0 or parsed > 600:
        raise argparse.ArgumentTypeError("must be > 0 and <= 600")
    return parsed




def _env_int(name: str, default: int, minimum: int, maximum: int) -> tuple[int, int]:
    raw = os.environ.get(name)
    try:
        requested = int(raw) if raw is not None else default
    except ValueError:
        requested = default
    return requested, max(minimum, min(maximum, requested))

def _safe_url(value: str) -> str:
    try:
        parts = urlsplit(value)
        if not parts.scheme or not parts.netloc:
            return "<configured-nonstandard-url>"
        host = parts.hostname or ""
        if ":" in host and not host.startswith("["):
            host = f"[{host}]"
        port = f":{parts.port}" if parts.port is not None else ""
        return urlunsplit((parts.scheme, host + port, parts.path, "", ""))
    except Exception:
        return "<configured-unparseable-url>"


def _bounded_error(exc: BaseException) -> dict[str, str]:
    # Do not echo remote response text: it may contain credentials or attacker-controlled data.
    type_name = type(exc).__name__
    lowered = type_name.lower()
    if "timeout" in lowered:
        message = "request timed out"
    elif "connect" in lowered:
        message = "backend connection failed"
    else:
        message = "backend request failed"
    return {"type": type_name, "message": message}



def _post_json(url: str, payload: dict[str, Any], headers: dict[str, str], timeout: float) -> Any:
    parts = urlsplit(url)
    if parts.scheme not in {"http", "https"} or not parts.hostname:
        raise ValueError("reranker URL must use http or https")
    if parts.fragment or parts.username or parts.password:
        raise ValueError("reranker URL must not contain credentials or fragment")
    path = parts.path or "/"
    if parts.query:
        path = f"{path}?{parts.query}"
    connection_cls = http.client.HTTPSConnection if parts.scheme == "https" else http.client.HTTPConnection
    connection = connection_cls(parts.hostname, parts.port, timeout=timeout)
    body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    try:
        connection.request("POST", path, body=body, headers=headers)
        response = connection.getresponse()
        raw = response.read()
        if response.status < 200 or response.status >= 300:
            raise RuntimeError("reranker backend returned non-success status")
        return json.loads(raw)
    finally:
        connection.close()

def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Benchmark the configured Awoki reranker with fixed synthetic query/documents only. "
            "Run through awoki-runtime-env --profile retrieval."
        )
    )
    parser.add_argument("--documents", type=_positive_int, default=12, help="synthetic candidate count (default: 12)")
    parser.add_argument("--timeout-seconds", type=_positive_float, default=None, help="request timeout override")
    parser.add_argument("--json", action="store_true", help="emit one JSON object")
    args = parser.parse_args()

    if os.environ.get("AWOKI_RUNTIME_ENV_PROFILE") not in {"retrieval", "all"}:
        parser.error("run through awoki-runtime-env --profile retrieval")

    enabled = (os.environ.get("AWOKI_RERANK_ENABLED") or "0").strip().lower() in {"1", "true", "yes", "on"}
    provider = (os.environ.get("AWOKI_RERANK_PROVIDER") or "tei").strip().lower()
    if provider in {"text-embeddings-inference", "huggingface-tei", "hf-tei"}:
        provider = "tei"
    elif provider in {"openai", "openai_compatible", "remote", "url"}:
        provider = "http"
    url = (os.environ.get("AWOKI_RERANK_URL") or "").strip()
    model = (os.environ.get("AWOKI_RERANK_MODEL") or "").strip()
    api_key = (os.environ.get("AWOKI_RERANK_API_KEY") or "").strip()
    api_key_source = "direct" if api_key else "none"
    auth_configuration_error = ""
    api_key_env = (os.environ.get("AWOKI_RERANK_API_KEY_ENV") or "").strip()
    if not api_key and api_key_env:
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", api_key_env) is None:
            auth_configuration_error = "AWOKI_RERANK_API_KEY_ENV is not a valid environment variable name"
        else:
            api_key = (os.environ.get(api_key_env) or "").strip()
            if api_key:
                api_key_source = "indirect"
            else:
                auth_configuration_error = (
                    f"configured reranker credential environment variable {api_key_env} is unavailable"
                )
    requested_timeout, configured_timeout = _env_int("AWOKI_RERANK_TIMEOUT_SECONDS", 20, 1, 300)
    timeout = args.timeout_seconds or max(float(configured_timeout), 30.0)
    _requested_top_n, configured_top_n = _env_int("AWOKI_RERANK_TOP_N", 10, 1, 50)
    top_n = min(configured_top_n, args.documents)

    result: dict[str, Any] = {
        "enabled": enabled,
        "provider": provider,
        "url": _safe_url(url) if url else "<unset>",
        "model": model,
        "auth_configured": bool(api_key),
        "auth_key_source": api_key_source,
        "auth_configuration_error": auth_configuration_error,
        "requested_timeout_seconds": requested_timeout,
        "configured_timeout_seconds": configured_timeout,
        "benchmark_timeout_seconds": timeout,
        "benchmark_transport": "python_stdlib_http",
        "benchmark_follows_redirects": False,
        "documents": args.documents,
        "synthetic_text_only": True,
    }

    if not enabled:
        result.update({"status": "skipped", "reason": "reranker disabled"})
    elif not url:
        result.update({"status": "failed", "reason": "AWOKI_RERANK_URL is not configured"})
    elif auth_configuration_error:
        result.update({"status": "failed", "reason": auth_configuration_error})
    else:
        query = "which code decides whether an authenticated request may proceed upstream"
        base_docs = [
            "Reverse proxy request rewrite preserves selected trusted forwarding headers.",
            "Authenticator checks a bearer token and returns an authentication session.",
            "Authorizer decides whether the authenticated subject may access the requested resource.",
            "Configuration schema documents logging verbosity and tracing options.",
            "Rule matcher compares request URL and method against configured access rules.",
            "Mutator copies identity fields into upstream request headers.",
        ]
        documents = [base_docs[i % len(base_docs)] + f" Candidate {i}." for i in range(args.documents)]
        headers = {"Content-Type": "application/json"}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
        if provider == "tei":
            payload: dict[str, Any] = {"query": query, "texts": documents, "raw_scores": False}
        else:
            payload = {"query": query, "documents": documents, "top_n": top_n}
            if model:
                payload["model"] = model

        started = time.monotonic()
        try:
            body = _post_json(url, payload, headers, timeout)
            rows = body.get("results") if isinstance(body, dict) else body
            if not isinstance(rows, list):
                raise RuntimeError("reranker response must contain a results list")
            usable: list[tuple[int, float]] = []
            for position, row in enumerate(rows):
                if not isinstance(row, dict):
                    continue
                index = row.get("index", row.get("document_index", row.get("id", position)))
                score = row.get("relevance_score", row.get("score", row.get("similarity")))
                try:
                    idx = int(index)
                    numeric = float(score)
                except (TypeError, ValueError):
                    continue
                if 0 <= idx < len(documents):
                    usable.append((idx, numeric))
            if not usable:
                raise RuntimeError("reranker response contained no usable index/score pairs")
            elapsed = time.monotonic() - started
            result.update({
                "status": "ok",
                "seconds": round(elapsed, 3),
                "rows": len(rows),
                "usable_rows": len(usable),
                "contract_ok": True,
                "fits_configured_timeout": elapsed <= configured_timeout,
            })
        except Exception as exc:
            elapsed = time.monotonic() - started
            result.update({"status": "failed", "seconds": round(elapsed, 3), **_bounded_error(exc)})

    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        for key in (
            "enabled", "provider", "url", "model", "auth_configured", "auth_key_source", "auth_configuration_error", "requested_timeout_seconds", "configured_timeout_seconds",
            "benchmark_timeout_seconds", "benchmark_transport", "benchmark_follows_redirects", "documents", "status", "reason", "seconds", "rows",
            "usable_rows", "contract_ok", "fits_configured_timeout", "type", "message",
        ):
            if key in result:
                print(f"{key}: {result[key]}")
    return 0 if result.get("status") in {"ok", "skipped"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
